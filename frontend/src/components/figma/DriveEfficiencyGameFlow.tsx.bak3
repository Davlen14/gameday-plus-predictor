import React from 'react';
import { GlassCard } from './GlassCard';
import { ImageWithFallback } from './figma/ImageWithFallback';
import {
  TrendingUp,
  Target,
  Activity,
  Zap,
  MapPin,
  BarChart3,
  Shield,
  Clock,
  ArrowRight,
  Flame,
  TrendingDown,
  Minus,
  Crosshair,
} from 'lucide-react';
import {
  LineChart,
  Line,
  BarChart,
  Bar,
  RadarChart,
  PolarGrid,
  PolarAngleAxis,
  PolarRadiusAxis,
  Radar,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  Legend,
  ResponsiveContainer
} from 'recharts';

interface DriveEfficiencyGameFlowProps {
  predictionData?: any;
}

export const DriveEfficiencyGameFlow: React.FC<DriveEfficiencyGameFlowProps> = ({
  predictionData,
}) => {
  // Extract team data from team_selector
  const awayTeam = predictionData?.team_selector?.away_team || { name: 'Away', abbreviation: 'AWAY', logo: '', primary_color: '#ef4444' };
  const homeTeam = predictionData?.team_selector?.home_team || { name: 'Home', abbreviation: 'HOME', logo: '', primary_color: '#3b82f6' };

  const homeAbbr = homeTeam.abbreviation || homeTeam.name?.substring(0, 4).toUpperCase() || 'HOME';
  const awayAbbr = awayTeam.abbreviation || awayTeam.name?.substring(0, 4).toUpperCase() || 'AWAY';

  // Helper function to detect blue or black colors (same as ComprehensiveStats)
  const isBlueOrBlack = (color: string) => {
    const hex = color.toLowerCase();
    const isBlue = hex.includes('004') || hex.includes('003') || hex.includes('002') || hex.includes('001') || 
                   hex === '#000080' || hex === '#003366' || hex === '#002244' || hex === '#041e42';
    const isBlack = hex === '#000000' || hex === '#222222' || hex === '#1a1a1a' || hex === '#333333';
    return isBlue || isBlack;
  };

  // Get display colors (same logic as ComprehensiveStats)
  const awayTeamColor = (awayTeamColor && isBlueOrBlack(awayTeamColor)) 
    ? (awayTeam.alt_color || awayTeam.secondary_color || '#f97316') 
    : (awayTeamColor || '#3b82f6');
    
  const homeTeamColor = (homeTeam.primary_color && isBlueOrBlack(homeTeam.primary_color)) 
    ? (homeTeam.alt_color || homeTeam.secondary_color || '#10b981') 
    : (homeTeam.primary_color || '#f97316');

  // Sample data structure - replace with actual data from predictionData
  const quarterlyPerformance = {
    away: { Q1: 62.1, Q2: 43.2, Q3: 55.3, Q4: 29.6 },
    home: { Q1: 57.6, Q2: 53.3, Q3: 40, Q4: 50 },
  };

  // Calculate play style indicators
  const calculatePlayStyle = (quarters: { Q1: number; Q2: number; Q3: number; Q4: number }) => {
    const q1 = quarters.Q1;
    const q2 = quarters.Q2;
    const q3 = quarters.Q3;
    const q4 = quarters.Q4;
    
    const firstHalf = (q1 + q2) / 2;
    const secondHalf = (q3 + q4) / 2;
    const differential = secondHalf - firstHalf;
    
    // Determine style
    let style = '';
    let IconComponent: any = null;
    let color = '';
    
    if (differential > 10) {
      style = 'Strong Finisher';
      IconComponent = Flame;
      color = 'text-orange-400';
    } else if (differential < -10) {
      style = 'Fast Starter';
      IconComponent = Zap;
      color = 'text-yellow-400';
    } else if (Math.max(q1, q2, q3, q4) - Math.min(q1, q2, q3, q4) < 10) {
      style = 'Consistent';
      IconComponent = Minus;
      color = 'text-green-400';
    } else {
      style = 'Momentum Shifter';
      IconComponent = TrendingUp;
      color = 'text-blue-400';
    }
    
    return { style, IconComponent, color, firstHalf, secondHalf, differential };
  };

  const homeStyle = calculatePlayStyle(quarterlyPerformance.home);
  const awayStyle = calculatePlayStyle(quarterlyPerformance.away);

  const fieldPositionScoring = {
    away: {
      'Own 1-20': { drives: 25, scoring: 20 },
      'Own 21-40': { drives: 39, scoring: 66.7 },
      'Own 41-Mid': { drives: 9, scoring: 33.3 },
      'Opp Territory': { drives: 59, scoring: 50.8 },
    },
    home: {
      'Own 1-20': { drives: 22, scoring: 50 },
      'Own 21-40': { drives: 37, scoring: 54.1 },
      'Own 41-Mid': { drives: 7, scoring: 85.7 },
      'Opp Territory': { drives: 60, scoring: 43.3 },
    },
  };

  const driveOutcomes = {
    away: {
      touchdowns: 37.1,
      fieldGoals: 10.6,
      punts: 29.5,
      turnovers: 9.8,
      powerSuccess: 47.7,
    },
    home: {
      touchdowns: 38.9,
      fieldGoals: 10.3,
      punts: 27,
      turnovers: 7.9,
      powerSuccess: 49.2,
    },
  };

  const gameControlMetrics = {
    away: {
      possessionTime: '402:05',
      possessionPercent: 50.3,
      turnoverMargin: -1,
      turnoverPercent: -14.3,
      penaltyYards: 491,
      penaltyPercent: 47.9,
      gamesPlayed: 12,
      gamesPercent: 50.0,
      drivesPerGame: 10.2,
      drivesPercent: 50.2,
    },
    home: {
      possessionTime: '398:03',
      possessionPercent: 49.7,
      turnoverMargin: 8,
      turnoverPercent: 114.3,
      penaltyYards: 535,
      penaltyPercent: 52.1,
      gamesPlayed: 12,
      gamesPercent: 50.0,
      drivesPerGame: 10.1,
      drivesPercent: 49.8,
    },
  };

  // Count advantages for game control
  const awayAdvantages = [
    gameControlMetrics.away.possessionPercent > gameControlMetrics.home.possessionPercent,
    gameControlMetrics.away.turnoverMargin > gameControlMetrics.home.turnoverMargin,
    gameControlMetrics.away.penaltyYards < gameControlMetrics.home.penaltyYards,
    gameControlMetrics.away.drivesPerGame > gameControlMetrics.home.drivesPerGame,
  ].filter(Boolean).length;

  const homeAdvantages = 4 - awayAdvantages;

  // Prepare chart data
  const quarterChartData = [
    { quarter: 'Q1', [awayTeam.name]: quarterlyPerformance.away.Q1, [homeTeam.name]: quarterlyPerformance.home.Q1 },
    { quarter: 'Q2', [awayTeam.name]: quarterlyPerformance.away.Q2, [homeTeam.name]: quarterlyPerformance.home.Q2 },
    { quarter: 'Q3', [awayTeam.name]: quarterlyPerformance.away.Q3, [homeTeam.name]: quarterlyPerformance.home.Q3 },
    { quarter: 'Q4', [awayTeam.name]: quarterlyPerformance.away.Q4, [homeTeam.name]: quarterlyPerformance.home.Q4 },
  ];

  const fieldPositionChartData = [
    { zone: '1-20', [awayTeam.name]: fieldPositionScoring.away['Own 1-20'].scoring, [homeTeam.name]: fieldPositionScoring.home['Own 1-20'].scoring },
    { zone: '21-40', [awayTeam.name]: fieldPositionScoring.away['Own 21-40'].scoring, [homeTeam.name]: fieldPositionScoring.home['Own 21-40'].scoring },
    { zone: '41-Mid', [awayTeam.name]: fieldPositionScoring.away['Own 41-Mid'].scoring, [homeTeam.name]: fieldPositionScoring.home['Own 41-Mid'].scoring },
    { zone: 'Opp Territory', [awayTeam.name]: fieldPositionScoring.away['Opp Territory'].scoring, [homeTeam.name]: fieldPositionScoring.home['Opp Territory'].scoring },
  ];

  const radarChartData = [
    { metric: 'TD%', [awayTeam.name]: driveOutcomes.away.touchdowns, [homeTeam.name]: driveOutcomes.home.touchdowns },
    { metric: 'FG%', [awayTeam.name]: driveOutcomes.away.fieldGoals, [homeTeam.name]: driveOutcomes.home.fieldGoals },
    { metric: 'POWER', [awayTeam.name]: driveOutcomes.away.powerSuccess, [homeTeam.name]: driveOutcomes.home.powerSuccess },
    { metric: 'PUNT', [awayTeam.name]: driveOutcomes.away.punts, [homeTeam.name]: driveOutcomes.home.punts },
    { metric: 'TO%', [awayTeam.name]: driveOutcomes.away.turnovers, [homeTeam.name]: driveOutcomes.home.turnovers },
  ];

  return (
    <GlassCard className="p-6 border-slate-500/40">
      {/* Tactical Header */}
      <div className="flex items-center justify-between mb-6 pb-4 border-b border-slate-700/50">
        <div className="flex items-center gap-3">
          <div className="p-2 rounded-lg bg-slate-800/60 border border-slate-600/40">
            <Crosshair className="w-5 h-5 text-cyan-400 animate-pulse" />
          </div>
          <div>
            <h3 className="text-white font-bold text-lg uppercase tracking-wider">Tactical Drive Analytics</h3>
            <p className="text-slate-400 text-xs uppercase tracking-widest font-mono">Efficiency Velocity & Zone Mastery</p>
          </div>
        </div>
        <div className="flex gap-4">
          <div className="text-center px-3 py-2 bg-slate-900/50 rounded border border-slate-700">
            <div className="text-xs text-slate-500 uppercase font-mono">Unit A</div>
            <div className="font-bold text-sm" style={{ color: awayTeamColor }}>{awayAbbr}</div>
          </div>
          <div className="text-center px-3 py-2 bg-slate-900/50 rounded border border-slate-700">
            <div className="text-xs text-slate-500 uppercase font-mono">Unit B</div>
            <div className="font-bold text-sm" style={{ color: homeTeamColor }}>{homeAbbr}</div>
          </div>
        </div>
      </div>

      {/* Main Grid */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-6">
        
        {/* Quarter Performance - Sharp Line Chart */}
        <div className="lg:col-span-8 bg-[#0a0a0a] border border-slate-800 rounded-lg p-6">
          <div className="flex justify-between items-start mb-4">
            <div>
              <h4 className="text-white font-bold uppercase tracking-wider flex items-center gap-2 text-sm">
                <Activity className="w-4 h-4 text-cyan-400" />
                Efficiency Velocity
              </h4>
              <p className="text-xs text-slate-500 font-mono mt-1">Quarter-by-Quarter Scoring %</p>
            </div>
            <div className="text-right font-mono text-xs">
              <div className="text-slate-500">MAX VARIANCE</div>
              <div className="text-cyan-400 font-bold">
                {Math.max(...quarterChartData.map(d => Math.abs(d[awayTeam.name] - d[homeTeam.name]))).toFixed(1)}%
              </div>
            </div>
          </div>
          
          <div className="h-[320px] w-full">
            <ResponsiveContainer width="100%" height="100%">
              <LineChart data={quarterChartData}>
                <defs>
                  <linearGradient id="awayGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stopColor={awayTeamColor} stopOpacity={0.1} />
                    <stop offset="100%" stopColor={awayTeamColor} stopOpacity={0} />
                  </linearGradient>
                  <linearGradient id="homeGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stopColor={homeTeam.primary_color} stopOpacity={0.1} />
                    <stop offset="100%" stopColor={homeTeam.primary_color} stopOpacity={0} />
                  </linearGradient>
                </defs>
                <CartesianGrid strokeDasharray="3 3" stroke="#1a1a1a" />
                <XAxis 
                  dataKey="quarter" 
                  stroke="#666" 
                  style={{ fontSize: '12px', fontFamily: 'monospace' }}
                />
                <YAxis 
                  stroke="#666" 
                  style={{ fontSize: '12px', fontFamily: 'monospace' }}
                  domain={[0, 100]}
                  tickFormatter={(val) => `${val}%`}
                />
                <Tooltip
                  contentStyle={{
                    backgroundColor: 'rgba(0,0,0,0.95)',
                    border: '1px solid #333',
                    borderRadius: '4px',
                    fontFamily: 'monospace'
                  }}
                  labelStyle={{ color: '#fff' }}
                  itemStyle={{ color: '#fff' }}
                  formatter={(value: any) => `${value}%`}
                />
                <Legend 
                  wrapperStyle={{ fontFamily: 'monospace', fontSize: '11px' }}
                />
                <Line
                  type="monotone"
                  dataKey={awayTeam.name}
                  stroke={awayTeamColor}
                  strokeWidth={2}
                  dot={{ r: 4, fill: '#000', stroke: awayTeamColor, strokeWidth: 2 }}
                  activeDot={{ r: 6 }}
                  fill="url(#awayGradient)"
                />
                <Line
                  type="monotone"
                  dataKey={homeTeam.name}
                  stroke={homeTeam.primary_color}
                  strokeWidth={2}
                  strokeDasharray="5 5"
                  dot={{ r: 4, fill: '#000', stroke: homeTeam.primary_color, strokeWidth: 2 }}
                  activeDot={{ r: 6 }}
                  fill="url(#homeGradient)"
                />
              </LineChart>
            </ResponsiveContainer>
          </div>

          {/* Quarter Deltas */}
          <div className="mt-4 grid grid-cols-4 gap-2 bg-slate-900/50 p-3 border border-slate-800 rounded">
            {quarterChartData.map((data, idx) => {
              const delta = data[awayTeam.name] - data[homeTeam.name];
              const leader = delta > 0 ? awayTeam.name : homeTeam.name;
              return (
                <div key={idx} className="text-center border-r border-slate-800 last:border-r-0">
                  <div className="text-[10px] text-slate-500 uppercase font-mono">{data.quarter}</div>
                  <div className={`font-mono text-xs font-bold ${delta > 0 ? 'text-cyan-400' : 'text-orange-400'}`}>
                    {Math.abs(delta).toFixed(1)}%
                  </div>
                  <div className="text-[9px] text-slate-600">{leader.split(' ').pop()}</div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Metrics Column */}
        <div className="lg:col-span-4 flex flex-col gap-4">
          
          {/* Ball Security Index */}
          <div className="bg-[#0a0a0a] border border-slate-800 rounded-lg p-5">
            <h4 className="text-xs font-bold uppercase text-slate-400 mb-4 border-b border-slate-800 pb-2 font-mono">
              Ball Security Index
            </h4>
            <div className="flex items-center justify-between mb-4">
              <div className="text-center">
                <div className="text-3xl font-bold font-mono" style={{ color: awayTeamColor, textShadow: `0 0 8px ${awayTeamColor}` }}>
                  {driveOutcomes.away.turnovers.toFixed(1)}<span className="text-sm">%</span>
                </div>
                <div className="text-[10px] uppercase tracking-widest mt-1 text-slate-500">{awayAbbr} Risk</div>
              </div>
              <div className="text-slate-600 text-xl font-thin">VS</div>
              <div className="text-center">
                <div className="text-3xl font-bold font-mono" style={{ color: homeTeam.primary_color, textShadow: `0 0 8px ${homeTeam.primary_color}` }}>
                  {driveOutcomes.home.turnovers.toFixed(1)}<span className="text-sm">%</span>
                </div>
                <div className="text-[10px] uppercase tracking-widest mt-1 text-slate-500">{homeAbbr} Risk</div>
              </div>
            </div>
            <div className="font-mono text-xs text-center border border-dashed border-slate-700 p-2 rounded" style={{
              background: driveOutcomes.away.turnovers < driveOutcomes.home.turnovers 
                ? 'rgba(0, 255, 136, 0.05)' 
                : 'rgba(255, 170, 0, 0.05)',
              color: driveOutcomes.away.turnovers < driveOutcomes.home.turnovers ? '#00ff88' : '#ffaa00',
              borderColor: driveOutcomes.away.turnovers < driveOutcomes.home.turnovers ? '#00ff88' : '#ffaa00'
            }}>
              <Shield className="w-3 h-3 inline mr-1" />
              {driveOutcomes.away.turnovers < driveOutcomes.home.turnovers ? awayAbbr : homeAbbr} ADVANTAGE
            </div>
          </div>

          {/* Power Success Bars */}
          <div className="bg-[#0a0a0a] border border-slate-800 rounded-lg p-5">
            <h4 className="text-xs font-bold uppercase text-slate-400 mb-4 border-b border-slate-800 pb-2 font-mono">
              Power Success Rate
            </h4>
            
            <div className="mb-4">
              <div className="flex justify-between text-xs mb-2 font-mono">
                <span className="text-slate-400">{awayAbbr}</span>
                <span className="text-white font-bold">{driveOutcomes.away.powerSuccess.toFixed(1)}%</span>
              </div>
              <div className="h-3 bg-slate-900 w-full relative border border-slate-800">
                <div 
                  style={{ width: `${driveOutcomes.away.powerSuccess}%`, backgroundColor: awayTeamColor, boxShadow: `0 0 10px ${awayTeamColor}` }}
                  className="h-full transition-all duration-500"
                />
              </div>
            </div>

            <div>
              <div className="flex justify-between text-xs mb-2 font-mono">
                <span className="text-slate-400">{homeAbbr}</span>
                <span className="text-white font-bold">{driveOutcomes.home.powerSuccess.toFixed(1)}%</span>
              </div>
              <div className="h-3 bg-slate-900 w-full relative border border-slate-800">
                <div 
                  style={{ width: `${driveOutcomes.home.powerSuccess}%`, backgroundColor: homeTeam.primary_color, boxShadow: `0 0 10px ${homeTeam.primary_color}` }}
                  className="h-full transition-all duration-500 opacity-80"
                />
              </div>
            </div>
          </div>

          {/* TD vs FG Split */}
          <div className="bg-[#0a0a0a] border border-slate-800 rounded-lg p-5 flex-grow flex flex-col justify-center">
            <h4 className="text-xs font-bold uppercase text-slate-400 mb-3 font-mono">TD/FG Split</h4>
            <div className="grid grid-cols-2 gap-3">
              <div className="text-center p-2 bg-slate-900/50 border border-slate-800 rounded">
                <div className="text-[10px] text-slate-500 uppercase">TDs</div>
                <div className="text-lg font-bold font-mono" style={{ color: awayTeamColor }}>
                  {driveOutcomes.away.touchdowns.toFixed(1)}%
                </div>
              </div>
              <div className="text-center p-2 bg-slate-900/50 border border-slate-800 rounded">
                <div className="text-[10px] text-slate-500 uppercase">TDs</div>
                <div className="text-lg font-bold font-mono" style={{ color: homeTeam.primary_color }}>
                  {driveOutcomes.home.touchdowns.toFixed(1)}%
                </div>
              </div>
              <div className="text-center p-2 bg-slate-900/50 border border-slate-800 rounded">
                <div className="text-[10px] text-slate-500 uppercase">FGs</div>
                <div className="text-sm font-bold font-mono text-cyan-400">
                  {driveOutcomes.away.fieldGoals.toFixed(1)}%
                </div>
              </div>
              <div className="text-center p-2 bg-slate-900/50 border border-slate-800 rounded">
                <div className="text-[10px] text-slate-500 uppercase">FGs</div>
                <div className="text-sm font-bold font-mono text-orange-400">
                  {driveOutcomes.home.fieldGoals.toFixed(1)}%
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Field Position & Radar Charts */}
      <div className="grid grid-cols-1 lg:grid-cols-7 gap-6 mb-6">
        
        {/* Field Position Histogram */}
        <div className="lg:col-span-4 bg-[#0a0a0a] border border-slate-800 rounded-lg p-6">
          <div className="flex justify-between items-start mb-6">
            <div>
              <h4 className="text-white font-bold uppercase tracking-wider flex items-center gap-2 text-sm">
                <Target className="w-4 h-4 text-cyan-400" />
                Zone Mastery
              </h4>
              <p className="text-xs text-slate-500 font-mono mt-1">Scoring Probability by Field Position</p>
            </div>
          </div>
          
          <div className="h-[280px] w-full">
            <ResponsiveContainer width="100%" height="100%">
              <BarChart data={fieldPositionChartData}>
                <CartesianGrid strokeDasharray="3 3" stroke="#1a1a1a" />
                <XAxis 
                  dataKey="zone" 
                  stroke="#666" 
                  style={{ fontSize: '10px', fontFamily: 'monospace' }}
                  angle={-20}
                  textAnchor="end"
                  height={60}
                />
                <YAxis 
                  stroke="#666" 
                  style={{ fontSize: '12px', fontFamily: 'monospace' }}
                  tickFormatter={(val) => `${val}%`}
                />
                <Tooltip
                  contentStyle={{
                    backgroundColor: 'rgba(0,0,0,0.95)',
                    border: '1px solid #333',
                    borderRadius: '4px',
                    fontFamily: 'monospace'
                  }}
                  formatter={(value: any) => `${value}%`}
                />
                <Bar 
                  dataKey={awayTeam.name} 
                  fill={awayTeamColor} 
                  opacity={0.9}
                  radius={[4, 4, 0, 0]}
                />
                <Bar 
                  dataKey={homeTeam.name} 
                  fill="transparent" 
                  stroke={homeTeam.primary_color}
                  strokeWidth={2}
                  radius={[4, 4, 0, 0]}
                />
              </BarChart>
            </ResponsiveContainer>
          </div>
        </div>

        {/* Drive Outcome Radar */}
        <div className="lg:col-span-3 bg-[#0a0a0a] border border-slate-800 rounded-lg p-6">
          <div className="mb-6">
            <h4 className="text-white font-bold uppercase tracking-wider flex items-center gap-2 text-sm">
              <Crosshair className="w-4 h-4 text-cyan-400" />
              Outcome Profile
            </h4>
            <p className="text-xs text-slate-500 font-mono mt-1">Drive Result Distribution</p>
          </div>
          
          <div className="h-[280px] w-full flex justify-center items-center relative">
            <ResponsiveContainer width="100%" height="100%">
              <RadarChart data={radarChartData}>
                <PolarGrid stroke="#333" />
                <PolarAngleAxis 
                  dataKey="metric" 
                  stroke="#fff"
                  style={{ fontSize: '11px', fontFamily: 'monospace', fill: '#fff' }}
                />
                <PolarRadiusAxis 
                  angle={90} 
                  domain={[0, 100]} 
                  tick={false}
                  stroke="#444"
                />
                <Radar
                  name={awayTeam.name}
                  dataKey={awayTeam.name}
                  stroke={awayTeamColor}
                  fill={awayTeamColor}
                  fillOpacity={0.15}
                  strokeWidth={2}
                />
                <Radar
                  name={homeTeam.name}
                  dataKey={homeTeam.name}
                  stroke={homeTeam.primary_color}
                  fill={homeTeam.primary_color}
                  fillOpacity={0.15}
                  strokeWidth={2}
                />
                <Tooltip
                  contentStyle={{
                    backgroundColor: 'rgba(0,0,0,0.95)',
                    border: '1px solid #333',
                    borderRadius: '4px',
                    fontFamily: 'monospace'
                  }}
                />
              </RadarChart>
            </ResponsiveContainer>
            {/* Decorative circle overlay */}
            <div className="absolute inset-0 rounded-full border border-dashed border-slate-800/50 w-[180px] h-[180px] m-auto pointer-events-none" />
          </div>
        </div>
      </div>

      {/* OLD CONTENT HIDDEN FOR REFERENCE */}
      <div className="hidden">
      {/* Quarter-by-Quarter Performance */}
      <div className="mb-8">
        <div className="flex items-center justify-between mb-6">
          <div className="flex items-center gap-3">
            <TrendingUp className="w-6 h-6 text-green-400" />
            <h4 className="text-xl font-bold text-white" style={{ fontFamily: 'Orbitron, sans-serif' }}>
              Quarter-by-Quarter Performance
            </h4>
          </div>
          
          {/* Play Style Indicators */}
          <div className="flex items-center gap-4">
            <div className="flex items-center gap-2 px-4 py-2 bg-white/5 backdrop-blur-sm rounded-full border border-white/10">
              <ImageWithFallback src={homeTeam.logo} alt={homeAbbr} className="w-6 h-6 object-contain" />
              {homeStyle.IconComponent && <homeStyle.IconComponent className={`w-5 h-5 ${homeStyle.color}`} />}
              <div className="text-left">
                <div className="text-xs text-gray-400">{homeAbbr}</div>
                <div className={`text-sm font-bold ${homeStyle.color}`}>{homeStyle.style}</div>
              </div>
            </div>
            <div className="flex items-center gap-2 px-4 py-2 bg-white/5 backdrop-blur-sm rounded-full border border-white/10">
              <ImageWithFallback src={awayTeam.logo} alt={awayAbbr} className="w-6 h-6 object-contain" />
              {awayStyle.IconComponent && <awayStyle.IconComponent className={`w-5 h-5 ${awayStyle.color}`} />}
              <div className="text-left">
                <div className="text-xs text-gray-400">{awayAbbr}</div>
                <div className={`text-sm font-bold ${awayStyle.color}`}>{awayStyle.style}</div>
              </div>
            </div>
          </div>
        </div>

        <div
          className="backdrop-blur-xl rounded-2xl p-6 border border-white/10"
          style={{
            background: 'rgba(255, 255, 255, 0.05)',
            boxShadow: '0 8px 32px rgba(0, 0, 0, 0.3)',
          }}
        >
          {/* Team Logo Watermarks */}
          <div className="absolute inset-0 pointer-events-none overflow-hidden rounded-2xl">
            <div 
              className="absolute left-10 top-1/2 -translate-y-1/2 opacity-5"
              style={{ width: '120px', height: '120px' }}
            >
              <ImageWithFallback 
                src={homeTeam.logo} 
                alt={homeAbbr} 
                className="w-full h-full object-contain"
              />
            </div>
            <div 
              className="absolute right-10 top-1/2 -translate-y-1/2 opacity-5"
              style={{ width: '120px', height: '120px' }}
            >
              <ImageWithFallback 
                src={awayTeam.logo} 
                alt={awayAbbr} 
                className="w-full h-full object-contain"
              />
            </div>
            <div 
              className="absolute inset-0"
              style={{
                background: `linear-gradient(90deg, ${homeTeamColor}08 0%, transparent 25%, transparent 75%, ${awayTeamColor}08 100%)`,
              }}
            />
          </div>
          
          <div style={{ height: '350px', position: 'relative', zIndex: 1 }}>
            <Bar
              data={{
                labels: ['Q1', 'Q2', 'Q3', 'Q4'],
                datasets: [
                  {
                    type: 'bar',
                    label: homeTeam.name,
                    data: Object.values(quarterlyPerformance.home),
                    backgroundColor: `${homeTeamColor}80`,
                    borderColor: homeTeamColor,
                    borderWidth: 2,
                    borderRadius: 8,
                    order: 2,
                  },
                  {
                    type: 'bar',
                    label: awayTeam.name,
                    data: Object.values(quarterlyPerformance.away),
                    backgroundColor: `${awayTeamColor}80`,
                    borderColor: awayTeamColor,
                    borderWidth: 2,
                    borderRadius: 8,
                    order: 2,
                  },
                  {
                    type: 'line',
                    label: `${homeTeam.name} Flow`,
                    data: Object.values(quarterlyPerformance.home),
                    borderColor: homeTeamColor,
                    backgroundColor: 'transparent',
                    borderWidth: 3,
                    tension: 0.4,
                    pointRadius: 6,
                    pointBackgroundColor: homeTeamColor,
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                    pointHoverRadius: 8,
                    order: 1,
                  },
                  {
                    type: 'line',
                    label: `${awayTeam.name} Flow`,
                    data: Object.values(quarterlyPerformance.away),
                    borderColor: awayTeamColor,
                    backgroundColor: 'transparent',
                    borderWidth: 3,
                    tension: 0.4,
                    pointRadius: 6,
                    pointBackgroundColor: awayTeamColor,
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                    pointHoverRadius: 8,
                    order: 1,
                  },
                ] as any,
              }}
              options={{
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                  legend: {
                    display: true,
                    position: 'top',
                    labels: {
                      color: '#ffffff',
                      font: { size: 14, weight: 'bold', family: 'Orbitron, sans-serif' },
                      padding: 20,
                      usePointStyle: true,
                      filter: (item) => !item.text.includes('Flow'),
                    },
                  },
                  tooltip: {
                    backgroundColor: 'rgba(0, 0, 0, 0.9)',
                    titleColor: '#22c55e',
                    bodyColor: '#ffffff',
                    borderColor: 'rgba(34, 197, 94, 0.5)',
                    borderWidth: 2,
                    padding: 12,
                    titleFont: { size: 14, weight: 'bold' },
                    bodyFont: { size: 13 },
                    callbacks: {
                      label: (context) => `${context.dataset.label}: ${context.parsed?.y?.toFixed(1) || 0}%`,
                    },
                  },
                },
                scales: {
                  x: {
                    grid: { color: 'rgba(255, 255, 255, 0.05)' },
                    ticks: {
                      color: '#ffffff',
                      font: { size: 12, weight: 'bold', family: 'Orbitron, sans-serif' },
                    },
                  },
                  y: {
                    grid: { color: 'rgba(255, 255, 255, 0.05)' },
                    ticks: {
                      color: '#ffffff',
                      font: { size: 12 },
                      callback: (value) => `${value}%`,
                    },
                    beginAtZero: true,
                    max: 100,
                  },
                },
              }}
            />
          </div>
          
          {/* Quarter Performance Breakdown */}
          <div className="grid grid-cols-2 md:grid-cols-4 gap-3 mt-6">
            {['Q1', 'Q2', 'Q3', 'Q4'].map((quarter, idx) => {
              const homeVal = Object.values(quarterlyPerformance.home)[idx];
              const awayVal = Object.values(quarterlyPerformance.away)[idx];
              const homeWins = homeVal > awayVal;
              const awayWins = awayVal > homeVal;
              const diff = Math.abs(homeVal - awayVal);
              
              return (
                <div key={quarter} className="bg-white/5 backdrop-blur-sm rounded-lg p-3 border border-white/10 relative overflow-hidden">
                  {/* Team color watermark */}
                  <div 
                    className="absolute inset-0 opacity-5"
                    style={{
                      background: `linear-gradient(135deg, ${homeTeamColor} 0%, transparent 50%, ${awayTeamColor} 100%)`,
                    }}
                  />
                  <div className="relative z-10">
                    <div className="text-center mb-2">
                      <span className="text-xs font-bold text-gray-400 uppercase">{quarter}</span>
                      {diff > 15 && (
                        <span className="ml-2 text-xs bg-orange-500/20 text-orange-400 px-2 py-0.5 rounded-full">
                          High Variance
                        </span>
                      )}
                    </div>
                    <div className="space-y-2">
                      <div className={`flex items-center justify-between text-xs ${homeWins ? 'text-green-400 font-semibold' : 'text-gray-400'}`}>
                        <div className="flex items-center gap-1">
                          <ImageWithFallback src={homeTeam.logo} alt={homeAbbr} className="w-4 h-4 object-contain" />
                          <span>{homeAbbr}</span>
                        </div>
                        <span>{homeVal.toFixed(1)}%</span>
                      </div>
                      <div className={`flex items-center justify-between text-xs ${awayWins ? 'text-green-400 font-semibold' : 'text-gray-400'}`}>
                        <div className="flex items-center gap-1">
                          <ImageWithFallback src={awayTeam.logo} alt={awayAbbr} className="w-4 h-4 object-contain" />
                          <span>{awayAbbr}</span>
                        </div>
                        <span>{awayVal.toFixed(1)}%</span>
                      </div>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      {/* Field Position Scoring Mastery */}
      <div className="mb-8">
        <div className="flex items-center justify-between mb-6">
          <div className="flex items-center gap-3">
            <MapPin className="w-6 h-6 text-amber-400" />
            <h4 className="text-xl font-bold text-white" style={{ fontFamily: 'Orbitron, sans-serif' }}>
              Field Position Scoring Mastery
            </h4>
          </div>
          <div className="flex items-center gap-4">
            <div className="flex items-center gap-2 px-3 py-1.5 bg-white/5 backdrop-blur-sm rounded-full border border-white/10">
              <ImageWithFallback src={homeTeam.logo} alt={homeAbbr} className="w-5 h-5 object-contain" />
              <span className="text-xs font-semibold" style={{ color: homeTeamColor }}>{homeTeam.name}</span>
            </div>
            <div className="flex items-center gap-2 px-3 py-1.5 bg-white/5 backdrop-blur-sm rounded-full border border-white/10">
              <ImageWithFallback src={awayTeam.logo} alt={awayAbbr} className="w-5 h-5 object-contain" />
              <span className="text-xs font-semibold" style={{ color: awayTeamColor }}>{awayTeam.name}</span>
            </div>
          </div>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
          {/* Home Team Field Position */}
          <div
            className="backdrop-blur-xl rounded-2xl p-6 border border-white/10 hover:border-white/20 transition-all"
            style={{
              background: 'rgba(255, 255, 255, 0.05)',
              boxShadow: '0 8px 32px rgba(0, 0, 0, 0.3)',
            }}
          >
            <div className="flex items-center gap-3 mb-4">
              <ImageWithFallback src={homeTeam.logo} alt={homeAbbr} className="w-10 h-10 object-contain" />
              <h5 className="text-lg font-bold text-white">{homeTeam.name}</h5>
            </div>
            <div style={{ height: '300px' }}>
              <Doughnut
                data={{
                  labels: Object.keys(fieldPositionScoring.home),
                  datasets: [
                    {
                      data: Object.values(fieldPositionScoring.home).map((d) => d.scoring),
                      backgroundColor: [
                        `${homeTeamColor}40`,
                        `${homeTeamColor}60`,
                        `${homeTeamColor}80`,
                        `${homeTeamColor}`,
                      ],
                      borderColor: [homeTeamColor, homeTeamColor, homeTeamColor, homeTeamColor],
                      borderWidth: 2,
                    },
                  ],
                }}
                options={{
                  responsive: true,
                  maintainAspectRatio: false,
                  plugins: {
                    legend: {
                      display: true,
                      position: 'bottom',
                      labels: {
                        color: '#ffffff',
                        font: { size: 11, family: 'Orbitron, sans-serif' },
                        padding: 15,
                      },
                    },
                    tooltip: {
                      backgroundColor: 'rgba(0, 0, 0, 0.9)',
                      titleColor: '#3b82f6',
                      bodyColor: '#ffffff',
                      borderColor: 'rgba(59, 130, 246, 0.5)',
                      borderWidth: 2,
                      padding: 12,
                      callbacks: {
                        label: (context) => `${context.label}: ${context.parsed}% scoring`,
                      },
                    },
                  },
                }}
              />
            </div>
          </div>

          {/* Away Team Field Position */}
          <div
            className="backdrop-blur-xl rounded-2xl p-6 border border-white/10 hover:border-white/20 transition-all"
            style={{
              background: 'rgba(255, 255, 255, 0.05)',
              boxShadow: '0 8px 32px rgba(0, 0, 0, 0.3)',
            }}
          >
            <div className="flex items-center gap-3 mb-4">
              <ImageWithFallback src={awayTeam.logo} alt={awayAbbr} className="w-10 h-10 object-contain" />
              <h5 className="text-lg font-bold text-white">{awayTeam.name}</h5>
            </div>
            <div style={{ height: '300px' }}>
              <Doughnut
                data={{
                  labels: Object.keys(fieldPositionScoring.away),
                  datasets: [
                    {
                      data: Object.values(fieldPositionScoring.away).map((d) => d.scoring),
                      backgroundColor: [
                        `${awayTeamColor}40`,
                        `${awayTeamColor}60`,
                        `${awayTeamColor}80`,
                        `${awayTeamColor}`,
                      ],
                      borderColor: [awayTeamColor, awayTeamColor, awayTeamColor, awayTeamColor],
                      borderWidth: 2,
                    },
                  ],
                }}
                options={{
                  responsive: true,
                  maintainAspectRatio: false,
                  plugins: {
                    legend: {
                      display: true,
                      position: 'bottom',
                      labels: {
                        color: '#ffffff',
                        font: { size: 11, family: 'Orbitron, sans-serif' },
                        padding: 15,
                      },
                    },
                    tooltip: {
                      backgroundColor: 'rgba(0, 0, 0, 0.9)',
                      titleColor: '#ef4444',
                      bodyColor: '#ffffff',
                      borderColor: 'rgba(239, 68, 68, 0.5)',
                      borderWidth: 2,
                      padding: 12,
                      callbacks: {
                        label: (context) => `${context.label}: ${context.parsed}% scoring`,
                      },
                    },
                  },
                }}
              />
            </div>
          </div>
        </div>

        {/* Field Position Mastery Table */}
        <div
          className="backdrop-blur-xl rounded-2xl p-6 border border-white/10 overflow-x-auto"
          style={{
            background: 'rgba(255, 255, 255, 0.05)',
            boxShadow: '0 8px 32px rgba(0, 0, 0, 0.3)',
          }}
        >
          <h5 className="text-lg font-bold text-white mb-4" style={{ fontFamily: 'Orbitron, sans-serif' }}>
            Field Position Mastery Analysis
          </h5>
          <table className="w-full text-sm">
            <thead>
              <tr className="border-b border-white/20">
                <th className="text-left py-3 px-4 text-gray-300 font-semibold">Field Position</th>
                <th className="text-center py-3 px-4 text-gray-300 font-semibold">{homeAbbr}</th>
                <th className="text-center py-3 px-4 text-gray-300 font-semibold">{awayAbbr}</th>
              </tr>
            </thead>
            <tbody>
              {Object.keys(fieldPositionScoring.home).map((position, idx) => {
                const homeData = fieldPositionScoring.home[position as keyof typeof fieldPositionScoring.home];
                const awayData = fieldPositionScoring.away[position as keyof typeof fieldPositionScoring.away];
                const homeWins = homeData.scoring > awayData.scoring;
                const awayWins = awayData.scoring > homeData.scoring;

                return (
                  <tr key={idx} className="border-b border-white/10 hover:bg-white/5 transition-colors">
                    <td className="py-3 px-4 text-gray-300 font-medium">{position}</td>
                    <td className={`py-3 px-4 text-center ${homeWins ? 'text-green-400 font-semibold' : 'text-gray-400'}`}>
                      <div>{homeData.drives} drives</div>
                      <div className="text-xs">{homeData.scoring}% scoring</div>
                    </td>
                    <td className={`py-3 px-4 text-center ${awayWins ? 'text-green-400 font-semibold' : 'text-gray-400'}`}>
                      <div>{awayData.drives} drives</div>
                      <div className="text-xs">{awayData.scoring}% scoring</div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

      {/* Drive Outcome Breakdown */}
      <div className="mb-8">
        <div className="flex items-center justify-between mb-6">
          <div className="flex items-center gap-3">
            <Target className="w-6 h-6 text-blue-400" />
            <div>
              <h4 className="text-xl font-bold text-white" style={{ fontFamily: 'Orbitron, sans-serif' }}>
                Drive Outcome Breakdown
              </h4>
              <span className="text-sm text-gray-400">
                Power Success, Success Rate, Explosiveness & Efficiency
              </span>
            </div>
          </div>
          <div className="flex items-center gap-4">
            <div className="flex items-center gap-2 px-3 py-1.5 bg-white/5 backdrop-blur-sm rounded-full border border-white/10">
              <ImageWithFallback src={homeTeam.logo} alt={homeAbbr} className="w-5 h-5 object-contain" />
              <span className="text-xs font-semibold" style={{ color: homeTeamColor }}>{homeTeam.name}</span>
            </div>
            <div className="flex items-center gap-2 px-3 py-1.5 bg-white/5 backdrop-blur-sm rounded-full border border-white/10">
              <ImageWithFallback src={awayTeam.logo} alt={awayAbbr} className="w-5 h-5 object-contain" />
              <span className="text-xs font-semibold" style={{ color: awayTeamColor }}>{awayTeam.name}</span>
            </div>
          </div>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {/* Home Team Outcomes */}
          <div
            className="backdrop-blur-xl rounded-2xl p-6 border border-white/10 hover:border-white/20 transition-all"
            style={{
              background: 'rgba(255, 255, 255, 0.05)',
              boxShadow: '0 8px 32px rgba(0, 0, 0, 0.3)',
            }}
          >
            <div className="flex items-center justify-between mb-6">
              <div className="flex items-center gap-3">
                <ImageWithFallback src={homeTeam.logo} alt={homeAbbr} className="w-12 h-12 object-contain" />
                <h5 className="text-lg font-bold text-white">{homeTeam.name}</h5>
              </div>
              {driveOutcomes.home.touchdowns > driveOutcomes.away.touchdowns && (
                <span className="text-xs bg-green-500/20 text-green-400 px-3 py-1 rounded-full border border-green-500/30">
                  {homeAbbr} Edge
                </span>
              )}
            </div>

            <div className="space-y-4">
              <div className="flex items-center justify-between">
                <span className="text-gray-300 text-sm">Touchdowns</span>
                <div className="flex items-center gap-3">
                  <div className="w-32 h-2 bg-white/10 rounded-full overflow-hidden">
                    <div
                      className="h-full bg-green-500 rounded-full"
                      style={{ width: `${driveOutcomes.home.touchdowns}%` }}
                    />
                  </div>
                  <span className="text-white font-bold w-12 text-right">{driveOutcomes.home.touchdowns}%</span>
                </div>
              </div>

              <div className="flex items-center justify-between">
                <span className="text-gray-300 text-sm">Field Goals</span>
                <div className="flex items-center gap-3">
                  <div className="w-32 h-2 bg-white/10 rounded-full overflow-hidden">
                    <div
                      className="h-full bg-yellow-500 rounded-full"
                      style={{ width: `${driveOutcomes.home.fieldGoals}%` }}
                    />
                  </div>
                  <span className="text-white font-bold w-12 text-right">{driveOutcomes.home.fieldGoals}%</span>
                </div>
              </div>

              <div className="flex items-center justify-between">
                <span className="text-gray-300 text-sm">Punts</span>
                <div className="flex items-center gap-3">
                  <div className="w-32 h-2 bg-white/10 rounded-full overflow-hidden">
                    <div
                      className="h-full bg-gray-500 rounded-full"
                      style={{ width: `${driveOutcomes.home.punts}%` }}
                    />
                  </div>
                  <span className="text-white font-bold w-12 text-right">{driveOutcomes.home.punts}%</span>
                </div>
              </div>

              <div className="flex items-center justify-between">
                <span className="text-gray-300 text-sm">Turnovers</span>
                <div className="flex items-center gap-3">
                  <div className="w-32 h-2 bg-white/10 rounded-full overflow-hidden">
                    <div
                      className="h-full bg-red-500 rounded-full"
                      style={{ width: `${driveOutcomes.home.turnovers}%` }}
                    />
                  </div>
                  <span className="text-white font-bold w-12 text-right">{driveOutcomes.home.turnovers}%</span>
                </div>
              </div>

              <div className="flex items-center justify-between pt-3 border-t border-white/10">
                <span className="text-gray-300 text-sm font-semibold">Power Success</span>
                <span className="text-green-400 font-bold text-lg">{driveOutcomes.home.powerSuccess}%</span>
              </div>
            </div>
          </div>

          {/* Away Team Outcomes */}
          <div
            className="backdrop-blur-xl rounded-2xl p-6 border border-white/10 hover:border-white/20 transition-all"
            style={{
              background: 'rgba(255, 255, 255, 0.05)',
              boxShadow: '0 8px 32px rgba(0, 0, 0, 0.3)',
            }}
          >
            <div className="flex items-center justify-between mb-6">
              <div className="flex items-center gap-3">
                <ImageWithFallback src={awayTeam.logo} alt={awayAbbr} className="w-12 h-12 object-contain" />
                <h5 className="text-lg font-bold text-white">{awayTeam.name}</h5>
              </div>
              {driveOutcomes.away.touchdowns > driveOutcomes.home.touchdowns && (
                <span className="text-xs bg-green-500/20 text-green-400 px-3 py-1 rounded-full border border-green-500/30">
                  {awayAbbr} Edge
                </span>
              )}
            </div>

            <div className="space-y-4">
              <div className="flex items-center justify-between">
                <span className="text-gray-300 text-sm">Touchdowns</span>
                <div className="flex items-center gap-3">
                  <div className="w-32 h-2 bg-white/10 rounded-full overflow-hidden">
                    <div
                      className="h-full bg-green-500 rounded-full"
                      style={{ width: `${driveOutcomes.away.touchdowns}%` }}
                    />
                  </div>
                  <span className="text-white font-bold w-12 text-right">{driveOutcomes.away.touchdowns}%</span>
                </div>
              </div>

              <div className="flex items-center justify-between">
                <span className="text-gray-300 text-sm">Field Goals</span>
                <div className="flex items-center gap-3">
                  <div className="w-32 h-2 bg-white/10 rounded-full overflow-hidden">
                    <div
                      className="h-full bg-yellow-500 rounded-full"
                      style={{ width: `${driveOutcomes.away.fieldGoals}%` }}
                    />
                  </div>
                  <span className="text-white font-bold w-12 text-right">{driveOutcomes.away.fieldGoals}%</span>
                </div>
              </div>

              <div className="flex items-center justify-between">
                <span className="text-gray-300 text-sm">Punts</span>
                <div className="flex items-center gap-3">
                  <div className="w-32 h-2 bg-white/10 rounded-full overflow-hidden">
                    <div
                      className="h-full bg-gray-500 rounded-full"
                      style={{ width: `${driveOutcomes.away.punts}%` }}
                    />
                  </div>
                  <span className="text-white font-bold w-12 text-right">{driveOutcomes.away.punts}%</span>
                </div>
              </div>

              <div className="flex items-center justify-between">
                <span className="text-gray-300 text-sm">Turnovers</span>
                <div className="flex items-center gap-3">
                  <div className="w-32 h-2 bg-white/10 rounded-full overflow-hidden">
                    <div
                      className="h-full bg-red-500 rounded-full"
                      style={{ width: `${driveOutcomes.away.turnovers}%` }}
                    />
                  </div>
                  <span className="text-white font-bold w-12 text-right">{driveOutcomes.away.turnovers}%</span>
                </div>
              </div>

              <div className="flex items-center justify-between pt-3 border-t border-white/10">
                <span className="text-gray-300 text-sm font-semibold">Power Success</span>
                <span className="text-green-400 font-bold text-lg">{driveOutcomes.away.powerSuccess}%</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Game Control Metrics */}
      <div>
        <div className="flex items-center justify-between mb-6">
          <div className="flex items-center gap-3">
            <Clock className="w-6 h-6 text-purple-400" />
            <div>
              <h4 className="text-xl font-bold text-white" style={{ fontFamily: 'Orbitron, sans-serif' }}>
                Game Control Metrics
              </h4>
              <span className="text-sm text-gray-400">Tempo and possession analytics</span>
            </div>
          </div>
          <div className="flex items-center gap-4">
            <div className="flex items-center gap-2 px-3 py-1.5 bg-white/5 backdrop-blur-sm rounded-full border border-white/10">
              <ImageWithFallback src={homeTeam.logo} alt={homeAbbr} className="w-5 h-5 object-contain" />
              <span className="text-xs font-semibold" style={{ color: homeTeamColor }}>{homeTeam.name}</span>
            </div>
            <div className="flex items-center gap-2 px-3 py-1.5 bg-white/5 backdrop-blur-sm rounded-full border border-white/10">
              <ImageWithFallback src={awayTeam.logo} alt={awayAbbr} className="w-5 h-5 object-contain" />
              <span className="text-xs font-semibold" style={{ color: awayTeamColor }}>{awayTeam.name}</span>
            </div>
          </div>
        </div>

        <div
          className="backdrop-blur-xl rounded-2xl p-6 border border-white/10"
          style={{
            background: 'rgba(255, 255, 255, 0.05)',
            boxShadow: '0 8px 32px rgba(0, 0, 0, 0.3)',
          }}
        >
          {/* Team Advantages */}
          <div className="flex items-center justify-center gap-12 mb-8">
            <div className="text-center">
              <ImageWithFallback src={homeTeam.logo} alt={homeAbbr} className="w-12 h-12 object-contain mx-auto mb-2" />
              <span className="font-bold text-sm" style={{ color: homeTeamColor }}>
                {homeAbbr} leads {homeAdvantages}
              </span>
            </div>
            <div className="text-center">
              <ImageWithFallback src={awayTeam.logo} alt={awayAbbr} className="w-12 h-12 object-contain mx-auto mb-2" />
              <span className="font-bold text-sm" style={{ color: awayTeamColor }}>
                {awayAbbr} leads {awayAdvantages}
              </span>
            </div>
          </div>

          {/* Metrics Grid */}
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {/* Possession Time - Tug of War Style */}
            <div className="bg-white/5 backdrop-blur-[10px] border border-white/10 rounded-xl p-4 hover:border-white/20 transition-all">
              <div className="text-xs text-gray-400 mb-4 font-semibold uppercase text-center">Possession Time</div>
              <div className="space-y-3">
                {/* Team Labels and Values */}
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <span className="text-sm font-bold text-gray-200">{awayAbbr}</span>
                    <span className={gameControlMetrics.away.possessionPercent > gameControlMetrics.home.possessionPercent ? 'text-green-400 font-bold text-lg' : 'text-gray-400 text-sm'}>
                      {gameControlMetrics.away.possessionTime}
                    </span>
                  </div>
                  <div className="flex items-center gap-2">
                    <span className={gameControlMetrics.home.possessionPercent > gameControlMetrics.away.possessionPercent ? 'text-green-400 font-bold text-lg' : 'text-gray-400 text-sm'}>
                      {gameControlMetrics.home.possessionTime}
                    </span>
                    <span className="text-sm font-bold text-gray-200">{homeAbbr}</span>
                  </div>
                </div>
                
                {/* Tug of War Bar */}
                <div className="relative">
                  <div className="flex h-8 rounded-lg overflow-hidden border-2 border-white/20">
                    <div
                      className="flex items-center justify-start px-3 font-bold text-sm transition-all duration-500"
                      style={{
                        width: `${gameControlMetrics.away.possessionPercent}%`,
                        background: `linear-gradient(to right, ${awayTeamColor}, ${awayTeamColor}dd)`,
                      }}
                    >
                      <span className="text-white drop-shadow-lg">{gameControlMetrics.away.possessionPercent}%</span>
                    </div>
                    <div
                      className="flex items-center justify-end px-3 font-bold text-sm transition-all duration-500"
                      style={{
                        width: `${gameControlMetrics.home.possessionPercent}%`,
                        background: `linear-gradient(to left, ${homeTeamColor}, ${homeTeamColor}dd)`,
                      }}
                    >
                      <span className="text-white drop-shadow-lg">{gameControlMetrics.home.possessionPercent}%</span>
                    </div>
                  </div>
                  {/* Center Divider */}
                  <div className="absolute top-0 left-1/2 transform -translate-x-1/2 h-8 w-1 bg-white/40"></div>
                </div>
                
                {/* Advantage Indicator */}
                {gameControlMetrics.away.possessionPercent !== gameControlMetrics.home.possessionPercent && (
                  <div className="text-center">
                    <span className="text-xs text-green-400 font-semibold px-3 py-1 bg-green-400/10 rounded-full border border-green-400/20">
                      {gameControlMetrics.away.possessionPercent > gameControlMetrics.home.possessionPercent ? `${awayAbbr} controls` : `${homeAbbr} controls`}
                    </span>
                  </div>
                )}
              </div>
            </div>

            {/* Turnover Margin - Tug of War Style */}
            <div className="bg-white/5 backdrop-blur-[10px] border border-white/10 rounded-xl p-4 hover:border-white/20 transition-all">
              <div className="text-xs text-gray-400 mb-4 font-semibold uppercase text-center">Turnover Margin</div>
              <div className="space-y-3">
                {/* Team Labels and Values */}
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <span className="text-sm font-bold text-gray-200">{awayAbbr}</span>
                    <span className={gameControlMetrics.away.turnoverMargin > gameControlMetrics.home.turnoverMargin ? 'text-green-400 font-bold text-lg' : 'text-gray-400 text-sm'}>
                      {gameControlMetrics.away.turnoverMargin > 0 ? '+' : ''}{gameControlMetrics.away.turnoverMargin}
                    </span>
                  </div>
                  <div className="flex items-center gap-2">
                    <span className={gameControlMetrics.home.turnoverMargin > gameControlMetrics.away.turnoverMargin ? 'text-green-400 font-bold text-lg' : 'text-gray-400 text-sm'}>
                      {gameControlMetrics.home.turnoverMargin > 0 ? '+' : ''}{gameControlMetrics.home.turnoverMargin}
                    </span>
                    <span className="text-sm font-bold text-gray-200">{homeAbbr}</span>
                  </div>
                </div>
                
                {/* Tug of War Bar */}
                <div className="relative">
                  <div className="flex h-8 rounded-lg overflow-hidden border-2 border-white/20">
                    <div
                      className="flex items-center justify-start px-3 font-bold text-sm transition-all duration-500"
                      style={{
                        width: `${Math.min(Math.abs(gameControlMetrics.away.turnoverPercent), 100)}%`,
                        background: gameControlMetrics.away.turnoverMargin > 0 
                          ? `linear-gradient(to right, ${awayTeamColor}, ${awayTeamColor}dd)`
                          : 'linear-gradient(to right, #ef4444, #ef4444dd)',
                      }}
                    >
                      <span className="text-white drop-shadow-lg">{Math.abs(gameControlMetrics.away.turnoverPercent)}%</span>
                    </div>
                    <div
                      className="flex items-center justify-end px-3 font-bold text-sm transition-all duration-500"
                      style={{
                        width: `${Math.abs(gameControlMetrics.home.turnoverPercent)}%`,
                        background: gameControlMetrics.home.turnoverMargin > 0
                          ? `linear-gradient(to left, ${homeTeamColor}, ${homeTeamColor}dd)`
                          : 'linear-gradient(to left, #ef4444, #ef4444dd)',
                      }}
                    >
                      <span className="text-white drop-shadow-lg">{Math.abs(gameControlMetrics.home.turnoverPercent)}%</span>
                    </div>
                  </div>
                  {/* Center Divider */}
                  <div className="absolute top-0 left-1/2 transform -translate-x-1/2 h-8 w-1 bg-white/40"></div>
                </div>
                
                {/* Advantage Indicator */}
                {gameControlMetrics.away.turnoverMargin !== gameControlMetrics.home.turnoverMargin && (
                  <div className="text-center">
                    <span className="text-xs text-green-400 font-semibold px-3 py-1 bg-green-400/10 rounded-full border border-green-400/20">
                      {gameControlMetrics.away.turnoverMargin > gameControlMetrics.home.turnoverMargin ? `${awayAbbr} protects ball` : `${homeAbbr} protects ball`}
                    </span>
                  </div>
                )}
              </div>
            </div>

            {/* Penalty Yards - Tug of War Style */}
            <div className="bg-white/5 backdrop-blur-[10px] border border-white/10 rounded-xl p-4 hover:border-white/20 transition-all">
              <div className="text-xs text-gray-400 mb-4 font-semibold uppercase text-center">Penalty Yards (Lower is Better)</div>
              <div className="space-y-3">
                {/* Team Labels and Values */}
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <span className="text-sm font-bold text-gray-200">{awayAbbr}</span>
                    <span className={gameControlMetrics.away.penaltyYards < gameControlMetrics.home.penaltyYards ? 'text-green-400 font-bold text-lg' : 'text-gray-400 text-sm'}>
                      {gameControlMetrics.away.penaltyYards}
                    </span>
                  </div>
                  <div className="flex items-center gap-2">
                    <span className={gameControlMetrics.home.penaltyYards < gameControlMetrics.away.penaltyYards ? 'text-green-400 font-bold text-lg' : 'text-gray-400 text-sm'}>
                      {gameControlMetrics.home.penaltyYards}
                    </span>
                    <span className="text-sm font-bold text-gray-200">{homeAbbr}</span>
                  </div>
                </div>
                
                {/* Tug of War Bar */}
                <div className="relative">
                  <div className="flex h-8 rounded-lg overflow-hidden border-2 border-white/20">
                    <div
                      className="flex items-center justify-start px-3 font-bold text-sm transition-all duration-500"
                      style={{
                        width: `${gameControlMetrics.away.penaltyPercent}%`,
                        background: gameControlMetrics.away.penaltyYards < gameControlMetrics.home.penaltyYards
                          ? `linear-gradient(to right, ${awayTeamColor}, ${awayTeamColor}dd)`
                          : 'linear-gradient(to right, #f59e0b, #f59e0bdd)',
                      }}
                    >
                      <span className="text-white drop-shadow-lg">{gameControlMetrics.away.penaltyPercent}%</span>
                    </div>
                    <div
                      className="flex items-center justify-end px-3 font-bold text-sm transition-all duration-500"
                      style={{
                        width: `${gameControlMetrics.home.penaltyPercent}%`,
                        background: gameControlMetrics.home.penaltyYards < gameControlMetrics.away.penaltyYards
                          ? `linear-gradient(to left, ${homeTeamColor}, ${homeTeamColor}dd)`
                          : 'linear-gradient(to left, #f59e0b, #f59e0bdd)',
                      }}
                    >
                      <span className="text-white drop-shadow-lg">{gameControlMetrics.home.penaltyPercent}%</span>
                    </div>
                  </div>
                  {/* Center Divider */}
                  <div className="absolute top-0 left-1/2 transform -translate-x-1/2 h-8 w-1 bg-white/40"></div>
                </div>
                
                {/* Advantage Indicator */}
                {gameControlMetrics.away.penaltyYards !== gameControlMetrics.home.penaltyYards && (
                  <div className="text-center">
                    <span className="text-xs text-green-400 font-semibold px-3 py-1 bg-green-400/10 rounded-full border border-green-400/20">
                      {gameControlMetrics.away.penaltyYards < gameControlMetrics.home.penaltyYards ? `${awayAbbr} more disciplined` : `${homeAbbr} more disciplined`}
                    </span>
                  </div>
                )}
              </div>
            </div>

            {/* Games Played - Tug of War Style */}
            <div className="bg-white/5 backdrop-blur-[10px] border border-white/10 rounded-xl p-4 hover:border-white/20 transition-all">
              <div className="text-xs text-gray-400 mb-4 font-semibold uppercase text-center">Games Played</div>
              <div className="space-y-3">
                {/* Team Labels and Values */}
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <span className="text-sm font-bold text-gray-200">{awayAbbr}</span>
                    <span className="text-gray-300 font-bold text-lg">{gameControlMetrics.away.gamesPlayed}</span>
                  </div>
                  <div className="flex items-center gap-2">
                    <span className="text-gray-300 font-bold text-lg">{gameControlMetrics.home.gamesPlayed}</span>
                    <span className="text-sm font-bold text-gray-200">{homeAbbr}</span>
                  </div>
                </div>
                
                {/* Tug of War Bar */}
                <div className="relative">
                  <div className="flex h-8 rounded-lg overflow-hidden border-2 border-white/20">
                    <div
                      className="flex items-center justify-start px-3 font-bold text-sm transition-all duration-500"
                      style={{
                        width: `${gameControlMetrics.away.gamesPercent}%`,
                        background: `linear-gradient(to right, ${awayTeamColor}, ${awayTeamColor}dd)`,
                      }}
                    >
                      <span className="text-white drop-shadow-lg">{gameControlMetrics.away.gamesPercent}%</span>
                    </div>
                    <div
                      className="flex items-center justify-end px-3 font-bold text-sm transition-all duration-500"
                      style={{
                        width: `${gameControlMetrics.home.gamesPercent}%`,
                        background: `linear-gradient(to left, ${homeTeamColor}, ${homeTeamColor}dd)`,
                      }}
                    >
                      <span className="text-white drop-shadow-lg">{gameControlMetrics.home.gamesPercent}%</span>
                    </div>
                  </div>
                  {/* Center Divider */}
                  <div className="absolute top-0 left-1/2 transform -translate-x-1/2 h-8 w-1 bg-white/40"></div>
                </div>
              </div>
            </div>

            {/* Drives Per Game - Tug of War Style */}
            <div className="bg-white/5 backdrop-blur-[10px] border border-white/10 rounded-xl p-4 hover:border-white/20 transition-all">
              <div className="text-xs text-gray-400 mb-4 font-semibold uppercase text-center">Drives Per Game</div>
              <div className="space-y-3">
                {/* Team Labels and Values */}
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <span className="text-sm font-bold text-gray-200">{awayAbbr}</span>
                    <span className={gameControlMetrics.away.drivesPerGame > gameControlMetrics.home.drivesPerGame ? 'text-green-400 font-bold text-lg' : 'text-gray-400 text-sm'}>
                      {gameControlMetrics.away.drivesPerGame}
                    </span>
                  </div>
                  <div className="flex items-center gap-2">
                    <span className={gameControlMetrics.home.drivesPerGame > gameControlMetrics.away.drivesPerGame ? 'text-green-400 font-bold text-lg' : 'text-gray-400 text-sm'}>
                      {gameControlMetrics.home.drivesPerGame}
                    </span>
                    <span className="text-sm font-bold text-gray-200">{homeAbbr}</span>
                  </div>
                </div>
                
                {/* Tug of War Bar */}
                <div className="relative">
                  <div className="flex h-8 rounded-lg overflow-hidden border-2 border-white/20">
                    <div
                      className="flex items-center justify-start px-3 font-bold text-sm transition-all duration-500"
                      style={{
                        width: `${gameControlMetrics.away.drivesPercent}%`,
                        background: `linear-gradient(to right, ${awayTeamColor}, ${awayTeamColor}dd)`,
                      }}
                    >
                      <span className="text-white drop-shadow-lg">{gameControlMetrics.away.drivesPercent}%</span>
                    </div>
                    <div
                      className="flex items-center justify-end px-3 font-bold text-sm transition-all duration-500"
                      style={{
                        width: `${gameControlMetrics.home.drivesPercent}%`,
                        background: `linear-gradient(to left, ${homeTeamColor}, ${homeTeamColor}dd)`,
                      }}
                    >
                      <span className="text-white drop-shadow-lg">{gameControlMetrics.home.drivesPercent}%</span>
                    </div>
                  </div>
                  {/* Center Divider */}
                  <div className="absolute top-0 left-1/2 transform -translate-x-1/2 h-8 w-1 bg-white/40"></div>
                </div>
                
                {/* Advantage Indicator */}
                {gameControlMetrics.away.drivesPerGame !== gameControlMetrics.home.drivesPerGame && (
                  <div className="text-center">
                    <span className="text-xs text-green-400 font-semibold px-3 py-1 bg-green-400/10 rounded-full border border-green-400/20">
                      {gameControlMetrics.away.drivesPerGame > gameControlMetrics.home.drivesPerGame ? `${awayAbbr} more possessions` : `${homeAbbr} more possessions`}
                    </span>
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
      </div>
      {/* END HIDDEN OLD CONTENT */}
    </GlassCard>
  );
};
